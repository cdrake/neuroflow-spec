{
  "$schema": "../schemas/0.1/tool.schema.json",
  "neuroflow": "0.1.0",
  "kind": "tool",
  "id": "neuroflow.examples/skull-strip",
  "version": "1.0.0",
  "description": "Headless brain extraction for a T1-weighted volume. Exercises the neuroflow/mcp extension (RFC 0009): a title override, annotation hints, and a longer wait budget before a runId handle is returned.",
  "inputs": {
    "t1": {
      "type": "neuro:volume",
      "description": "T1-weighted anatomical volume."
    },
    "threshold": {
      "type": "core:number",
      "description": "Fractional intensity threshold; smaller values give larger brain estimates.",
      "optional": true,
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  },
  "outputs": {
    "brain_volume": {
      "type": "neuro:volume",
      "description": "Skull-stripped T1 volume.",
      "delivery": { "mode": "core:result-dir", "path": "brain.nii.gz" }
    },
    "brain_mask": {
      "type": "neuro:mask",
      "description": "Binary brain mask.",
      "delivery": { "mode": "core:result-dir", "path": "brain_mask.nii.gz" }
    }
  },
  "outputDelivery": {
    "default": "core:result-dir"
  },
  "extensions": {
    "neuroflow/mcp": {
      "title": "Skull strip (brain extraction)",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "maxWaitMs": 120000
    }
  }
}
