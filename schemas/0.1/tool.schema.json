{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niivue.github.io/neuroflow-spec/schemas/0.1/tool.schema.json",
  "title": "NeuroFlow Tool Document",
  "description": "Normalized NeuroFlow tool document: a portable contract describing a single operation with typed inputs and outputs.",
  "type": "object",
  "required": ["neuroflow", "kind", "id", "version", "description", "inputs", "outputs"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for editor support."
    },
    "neuroflow": { "$ref": "common.schema.json#/$defs/specVersion" },
    "kind": { "const": "tool" },
    "id": { "$ref": "common.schema.json#/$defs/documentId" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "description": {
      "type": "string",
      "description": "Human-readable description of what the tool does."
    },
    "inputs": {
      "type": "object",
      "description": "Named input parameters.",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/typeDeclaration" }
    },
    "outputs": {
      "type": "object",
      "description": "Named output values.",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/typeDeclaration" }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
